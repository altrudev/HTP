{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ddc:htp:0.1",
  "title": "DDC Human Translation Protocol v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "conversation_id",
    "turn_id",
    "need",
    "projection",
    "authority",
    "evidence",
    "actions",
    "witness",
    "fractures",
    "repairs"
  ],
  "properties": {
    "protocol_version": { "const": "ddc-htp/0.1" },
    "conversation_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "predecessor_witness": { "type": ["string", "null"] },
    "need": { "$ref": "#/$defs/need" },
    "projection": { "$ref": "#/$defs/projection" },
    "authority": { "$ref": "#/$defs/authority" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "witness": { "$ref": "#/$defs/witness" },
    "fractures": { "type": "array", "items": { "$ref": "#/$defs/fracture" } },
    "repairs": { "type": "array", "items": { "$ref": "#/$defs/repair" } }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "dimension": {
      "enum": ["semantic", "authority", "state", "resource", "security", "physical", "frequency", "lineage"]
    },
    "need": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "objective", "constraints"],
      "properties": {
        "statement": { "type": "string" },
        "objective": { "type": "string", "minLength": 1 },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation", "assumptions", "ambiguities"],
      "properties": {
        "interpretation": { "type": "string", "minLength": 1 },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "ambiguities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "granted", "denied"],
      "properties": {
        "required": { "$ref": "#/$defs/stringSet" },
        "granted": { "$ref": "#/$defs/stringSet" },
        "denied": { "$ref": "#/$defs/stringSet" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "source", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["user_statement", "source", "tool_result", "system_observation", "calculation"] },
        "statement": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "status": { "enum": ["established", "inferred", "unknown", "contradicted"] }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "boundary"],
      "properties": {
        "dimension": { "$ref": "#/$defs/dimension" },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "requires", "status", "effects", "resource_delta", "reversible"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "requires": { "$ref": "#/$defs/stringSet" },
        "status": { "enum": ["proposed", "authorized", "executed", "failed", "skipped"] },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" }, "uniqueItems": true },
        "resource_delta": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "reversible": { "type": ["boolean", "null"] }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "recommendation", "evidence_ids", "action_ids"],
      "properties": {
        "conclusion": { "type": "string" },
        "recommendation": { "type": ["string", "null"] },
        "evidence_ids": { "$ref": "#/$defs/stringSet" },
        "action_ids": { "$ref": "#/$defs/stringSet" }
      }
    },
    "fracture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dimension", "summary", "severity", "evidence_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "dimension": { "$ref": "#/$defs/dimension" },
        "summary": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["advisory", "warning", "blocking"] },
        "evidence_ids": { "$ref": "#/$defs/stringSet" }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fracture_id", "summary", "evidence_ids"],
      "properties": {
        "fracture_id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "evidence_ids": { "$ref": "#/$defs/stringSet" }
      }
    }
  }
}
